# ---------------------------------------------------------------------------
# Supabase Cloud (source)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# Connexion directe a la base (migrations, dump)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Secrets applicatifs
# ---------------------------------------------------------------------------
# Cle AES-256-GCM utilisee pour chiffrer les documents medicaux avant upload
DOCUMENTS_ENCRYPTION_KEY=

# Fournisseur d'envoi de mails/SMS transactionnels (rappels de RDV)
BREVO_API_KEY=
BREVO_SENDER=no-reply@sillage-sante.example

# Modele d'embeddings pour la recherche dans les comptes rendus
OPENAI_API_KEY=

# Antivirus appele en webhook a chaque depot de document
ANTIVIRUS_WEBHOOK_URL=https://scan.example.internal/v1/scan
ANTIVIRUS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
